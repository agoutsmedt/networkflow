Package: networkflow
Title: A Research Pipeline for Projected and Dynamic Networks
Version: 0.0.9.9000
Authors@R: c(
    person("Aurélien", "Goutsmedt", , "agoutsmedt@hotmail.fr", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-3788-7237")),
    person("Alexandre", "Truc", , "alexandre.truc77@gmail.com", role = "aut",
